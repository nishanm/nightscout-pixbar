# Copy to .env on the deploy host and fill in. NEVER commit .env (.gitignore
# covers it). Values here override any config file - see config.py.
#
# Placeholders in angle brackets on purpose: this file is committed, and the
# repo already owes a scrub of the LAN addresses baked into config.py and
# push.py before it could ever be made public. Do not add more.
#
# On the NAS this file is root:root 600, like every other stack's .env, so
# compose must be run with sudo to read it.

# Where the panel is, and what it renders.
PIXBAR_HOST=<pixbar-ip>
PIXBAR_APP=nightscout
PIXBAR_FACE=hero-delta
PIXBAR_POLL_SECONDS=60
# >0 re-asserts switchDiyApp every n seconds so the panel can never be left on another
# app. Off by default because it fights the knob; the daemon always switches after a re-create.
PIXBAR_PIN_SECONDS=0
TZ=America/New_York

# --- glucose source: nightscout OR dexcom ---
PIXBAR_SOURCE=nightscout

# Nightscout. An instance running AUTH_DEFAULT_ROLES=denied returns 401 to an
# unauthenticated entries read, so give it one of the two below: a subject token,
# or the site's API_SECRET, which is sent as its SHA1 in an api-secret header.
PIXBAR_NIGHTSCOUT_URL=http://<nightscout-host>:<port>
PIXBAR_NIGHTSCOUT_API_SECRET=
PIXBAR_NIGHTSCOUT_TOKEN=

# Dexcom Share. Prefer Nightscout above when one is already collecting this
# history: every extra consumer is another login on the same account, and
# repeated failures from any one of them lock it. Leave empty unless
# PIXBAR_SOURCE=dexcom.
PIXBAR_DEXCOM_USERNAME=
PIXBAR_DEXCOM_PASSWORD=
PIXBAR_DEXCOM_SERVER=us
